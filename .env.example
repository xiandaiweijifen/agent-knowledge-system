# Use `v2` to route the default /api/query/agent surface through agent_v2.
# Keep `legacy` when you need the historical orchestrator behavior.
AGENT_DEFAULT_RUNTIME=legacy
EMBEDDING_PROVIDER=gemini
VECTOR_STORE_PROVIDER=qdrant
KNOWLEDGE_WRITE_QDRANT=true
KNOWLEDGE_WRITE_LLAMAINDEX=true
CHAT_PROVIDER=fallback
ROUTE_PLANNER_PROVIDER=fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_ROUTE_PLANNER_MODEL=
GEMINI_TOOL_PLANNER_MODEL=
GEMINI_CLARIFICATION_PLANNER_MODEL=
GEMINI_WORKFLOW_PLANNER_MODEL=
OPENAI_API_KEY=your_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_ROUTE_PLANNER_MODEL=
OPENAI_TOOL_PLANNER_MODEL=
OPENAI_CLARIFICATION_PLANNER_MODEL=
OPENAI_WORKFLOW_PLANNER_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TOOL_PLANNER_PROVIDER=fallback
CLARIFICATION_PLANNER_PROVIDER=fallback
WORKFLOW_PLANNER_PROVIDER=fallback
WORKFLOW_PLANNER_DEBUG_CAPTURE=false
PLANNER_CACHE_TTL_SECONDS=120
PLANNER_CACHE_MAX_ENTRIES=256
# Set to true only when you intentionally want httpx to inherit system proxy vars.
EMBEDDING_HTTP_TRUST_ENV=false
DATABASE_URL=postgresql://postgres:password@localhost:5432/agent_knowledge_system
REDIS_URL=redis://localhost:6379/0
# Prefer QDRANT_URL=http://localhost:6333 for local multi-process development.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agent_knowledge_chunks
QDRANT_LOCAL_PATH=
QDRANT_PREFER_GRPC=false

# --- LangSmith tracing ---
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-knowledge-system
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
